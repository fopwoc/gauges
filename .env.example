# A JSON array is used instead of a delimiter-based format so tokens and names
# can contain punctuation safely. Device ids must match probe configuration.
DEVICES_JSON=[{"id":"router","name":"OpenWrt router","token":"replace-with-a-long-random-token"},{"id":"nas","name":"Home NAS","token":"replace-with-another-long-random-token"}]

# Published host port for the combined hub and console.
HUB_HTTP_PORT=8080

# Hub durations are runtime configurable. History retention belongs
# to each probe's retention_hours / RETENTION_HOURS setting.
CLEANUP_INTERVAL_SECONDS=60
ONLINE_THRESHOLD_SECONDS=30

# Standard tracing filter. Use info for startup and upload lifecycle logs.
LOG_LEVEL=error
